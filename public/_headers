# Netlify security headers (Bolt deploys to Netlify).
# If you change the Supabase project, update connect-src below.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://bolt.new; style-src 'self' 'unsafe-inline' https://bolt.new; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://cynvztttocslvrpjhnbo.supabase.co wss://cynvztttocslvrpjhnbo.supabase.co; frame-src https://bolt.new; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=31536000, immutable
